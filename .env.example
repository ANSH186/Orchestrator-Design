# Runtime configuration for The Procurement Desk.
# Copy this file to .env and edit values. Never commit .env or API keys.

# --- LLM provider ---------------------------------------------------------
# none            : deterministic extractor only (safe default; works offline)
# mock            : deterministic mock provider for tests only
# openai_compatible: any /chat/completions endpoint with structured JSON output
PROCUREMENT_LLM_PROVIDER=none
PROCUREMENT_LLM_API_KEY=
PROCUREMENT_LLM_BASE_URL=https://api.openai.com/v1
PROCUREMENT_LLM_MODEL=gpt-4o-mini
PROCUREMENT_LLM_TIMEOUT_SECONDS=40
PROCUREMENT_LLM_MAX_RETRIES=2
PROCUREMENT_LLM_MAX_CONCURRENCY=4
PROCUREMENT_LLM_TEMPERATURE=0

# --- Paths -----------------------------------------------------------------
PROCUREMENT_DATA_DIR=data
PROCUREMENT_PLAYBOOK_DIR=data/playbook/playbook
PROCUREMENT_ARTIFACTS_DIR=artifacts
PROCUREMENT_OUTPUT_DIR=output
PROCUREMENT_REPORTS_DIR=reports

# --- Batch execution -------------------------------------------------------
PROCUREMENT_MAX_WORKERS=4
PROCUREMENT_CACHE_ENABLED=true
PROCUREMENT_LOG_LEVEL=INFO
PROCUREMENT_LOG_JSON=true
